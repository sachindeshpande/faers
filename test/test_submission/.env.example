# FDA ESG NextGen API credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# From USP portal → API Management → Generate (Power User role required)
ClientID=paste_your_client_id_here
Secret=paste_your_secret_key_here

# Your ESG NextGen USP portal login (email address and password)
ESG_USERNAME=sachindeshpande@deepquence.com
ESG_PASSWORD=paste_your_usp_password_here

# Email used to look up your user_id and company_id via the Companies API.
ESG_USER_EMAIL=sachindeshpande@deepquence.com

# Confirmed user_id and company_id — verified from Companies API on 2026-05-01.
# company_name=DeepQuence, company_status=Approved, agency=No.
# NOTE: Companies API requires NO Content-Type header on the GET request — sending
# Content-Type: application/json causes a 500 and returns wrong/no data.
#
# WRONG-VALUE TRAPS (each previously cost a multi-day debugging cycle):
#   ESG_USER_ID:    33703 is correct. It is NOT a typo — these are the real
#                   confirmed digits (the EIN 334818134 likewise carries a
#                   leading "3" that is a format artifact, not an error).
#                   The earlier poisoned value 27478 must never reappear.
#   ESG_COMPANY_ID: 31537 = DeepQuence. The earlier poisoned value 2 is CDER's
#                   OWN center record, returned by a malformed Companies API
#                   request. submit_batch.py refuses to run with company_id=2.
ESG_USER_ID=33703
ESG_COMPANY_ID=31537

# Credential body: fda_center and submission_type by track.
#
# Postmarket (TC-* files): fda_center=CDER, submission_type=AERS          → gateway ZZFDATST
# IND safety reports      : fda_center=CDER, submission_type=AERS_PREMKT_CDER → gateway ZZFDATST_PREMKT
#
# IMPORTANT: Both tracks use fda_center=CDER. The distinction is submission_type only.
# user_id and company_id must be sent as integers (no quotes) — confirmed by FDA helpdesk.
#
# DO NOT use submission_type=EIND for ICSRs. EIND routes to the FDA EIND
# regulatory system (the wrong system for ICSRs) — proven 2026-05-01. An earlier
# revision of this template wrongly listed EIND as "confirmed correct"; it is not.
#
# PLACEHOLDER WARNING: AERS_PREMKT_CDER is the current best-guess IND value, not a
# confirmed canonical token. Every IND-track combination tested so far returns
# ESGNG334 because the blocker is AEMSESUB account enrollment, not the field value.
# Update ESG_SUBMISSION_TYPE_IND only after a successful IND credential response (or
# an AEMSESUB helpdesk reply) identifies the real token. Do NOT assume the spec-style
# "IND" is correct — the matched pair CDER_IND + IND was tested and rejected.
ESG_CENTER=CDER
ESG_SUBMISSION_TYPE=AERS
ESG_CENTER_IND=CDER
ESG_SUBMISSION_TYPE_IND=AERS_PREMKT_CDER

# authorizing_company_id: DeepQuence is NOT an agency — leave blank.
# Only set this if submitting on behalf of another company as a CRO/agent.
ESG_AUTHORIZING_COMPANY_ID=
