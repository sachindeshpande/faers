# FDA ESG NextGen API credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# From USP portal → API Management → Generate (Power User role required)
ClientID=paste_your_client_id_here
Secret=paste_your_secret_key_here

# Your ESG NextGen USP portal login (email address and password)
ESG_USERNAME=sachindeshpande@deepquence.com
ESG_PASSWORD=paste_your_usp_password_here

# Email used to look up your user_id and company_id via the Companies API.
ESG_USER_EMAIL=sachindeshpande@deepquence.com

# Confirmed user_id and company_id — verified from Companies API on 2026-05-01.
# company_name=DeepQuence, company_status=Approved, agency=No.
# NOTE: Companies API requires NO Content-Type header on the GET request — sending
# Content-Type: application/json causes a 500 and returns wrong/no data.
ESG_USER_ID=33703
ESG_COMPANY_ID=31537

# Credential body: fda_center and submission_type by track.
# Confirmed correct values via FDA AEMSESUB helpdesk 2026-05-01.
# See: https://www.fda.gov/industry/getting-started-esg-nextgen/center-submission-types
#
# Postmarket (TC-* files): fda_center=CDER,  submission_type=AERS  → gateway ZZFDATST
# IND safety reports      : fda_center=CDER,  submission_type=EIND  → gateway ZZFDATST_PREMKT
#
# IMPORTANT: Both tracks use fda_center=CDER. The distinction is submission_type only.
# user_id and company_id must be sent as integers (no quotes) — confirmed by FDA helpdesk.
ESG_CENTER=CDER
ESG_SUBMISSION_TYPE=AERS
ESG_CENTER_IND=CDER
ESG_SUBMISSION_TYPE_IND=EIND

# authorizing_company_id: DeepQuence is NOT an agency — leave blank.
# Only set this if submitting on behalf of another company as a CRO/agent.
ESG_AUTHORIZING_COMPANY_ID=
